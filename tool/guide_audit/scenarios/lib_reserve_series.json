{
  "name": "lib_reserve_series",
  "description": "Default goal (reserve), app way. The user searches 滑塊書 (a book with several 冊次, lib-book-1), follows the cards: 取書館, ✕, then 預約. The page keeps 預約 disabled until a 冊次 checkbox is ticked; no card mentions 冊次.",
  "page": "library",
  "capability": "library",
  "goals": [],
  "expect": { "done": true },
  "actions": [
    { "step": "open_search", "do": "click", "selector": "a.search-bar" },
    { "step": "search_keyword", "do": "type", "selector": "input.base-input", "value": "滑塊書" },
    { "step": "search_keyword", "do": "click", "selector": "button.search-button" },
    { "step": "pick_book", "do": "click", "text": "我的第一本滑塊書 : 顏色配對" },
    { "step": "choose_branch", "do": "click", "selector": "div.fixed.bottom-0 .base-select-wrapper" },
    { "step": "choose_branch", "do": "click", "text": "B12三興", "within": "[id^=headlessui-dialog-panel]" },
    { "step": "choose_branch", "do": "click", "selector": "[id^=headlessui-dialog-title] button" },
    { "step": "reserve", "do": "click", "selector": "div.fixed.bottom-0 button.base-button" }
  ]
}
