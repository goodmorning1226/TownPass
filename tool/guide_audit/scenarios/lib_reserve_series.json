{
  "name": "lib_reserve_series",
  "description": "Default goal (reserve), app way. The user searches 滑塊書 (a book with several 冊次, lib-book-1) and follows the cards: tick a 冊次 (V. 1), 取書館, ✕, then 預約 (預約成功).",
  "page": "library",
  "capability": "library",
  "goals": [],
  "expect": {
    "done": true
  },
  "actions": [
    {
      "step": "open_search",
      "do": "click",
      "selector": "a.search-bar"
    },
    {
      "step": "search_keyword",
      "do": "type",
      "selector": "input.base-input",
      "value": "滑塊書"
    },
    {
      "step": "search_keyword",
      "do": "click",
      "selector": "button.search-button"
    },
    {
      "step": "pick_book",
      "do": "click",
      "text": "我的第一本滑塊書 : 顏色配對"
    },
    {
      "step": "choose_branch",
      "do": "check",
      "selector": "label.items-center[for=lib-series-1]"
    },
    {
      "step": "choose_branch",
      "do": "click",
      "selector": "div.fixed.bottom-0 .base-select-wrapper"
    },
    {
      "step": "choose_branch",
      "do": "click",
      "text": "B12三興",
      "within": "[id^=headlessui-dialog-panel]"
    },
    {
      "step": "choose_branch",
      "do": "click",
      "selector": "[id^=headlessui-dialog-title] button"
    },
    {
      "step": "reserve",
      "do": "click",
      "selector": "div.fixed.bottom-0 button.base-button"
    }
  ]
}
