{
  "name": "do_consent_c2",
  "description": "臺北市性侵害被害人補助 (districtOffice.form.c-2, opened like the app), goal consent: the user fills the form as the cards say, presses 下一步, scrolls through 個人資料是否提供給承辦員, picks 不同意.",
  "page": "district_office",
  "capability": "districtOffice.form.c-2",
  "goals": [
    "consent"
  ],
  "expect": {
    "done": true
  },
  "actions": [
    {
      "step": "fill_basic",
      "do": "type",
      "selector": "#mail",
      "value": "test@example.com"
    },
    {
      "step": "fill_basic",
      "do": "select",
      "selector": "#county",
      "value": "臺北市"
    },
    {
      "step": "fill_basic",
      "do": "select",
      "selector": "#city",
      "value": "信義區"
    },
    {
      "step": "fill_basic",
      "do": "type",
      "selector": "#address",
      "value": "測試路1號"
    },
    {
      "step": "fill_details",
      "do": "type",
      "selector": "#name",
      "value": "王小明"
    },
    {
      "step": "fill_details",
      "do": "select",
      "selector": "#agency",
      "value": "交通事件裁決所"
    },
    {
      "step": "fill_details",
      "do": "click",
      "selector": ".base-multiple-select-wrapper input"
    },
    {
      "step": "fill_details",
      "do": "check",
      "text": "車禍案件申訴"
    },
    {
      "step": "fill_details",
      "do": "click",
      "text": "確認",
      "within": "[id^=\"headlessui-dialog-panel\"]"
    },
    {
      "step": "fill_details",
      "do": "click",
      "selector": "label[for=\"send_by_mailY\"]"
    },
    {
      "step": "fill_details",
      "do": "type",
      "selector": "#content",
      "value": "測試內容"
    },
    {
      "step": "fill_details",
      "do": "click",
      "selector": "label[for=\"現場圖\"]"
    },
    {
      "step": "fill_details",
      "do": "click",
      "selector": "input[readonly]"
    },
    {
      "step": "fill_details",
      "do": "click",
      "selector": ".vc-day:not(.is-not-in-month) .vc-day-content",
      "nth": 2
    },
    {
      "step": "next_step",
      "do": "click",
      "text": "下一步"
    },
    {
      "step": "consent",
      "do": "scroll",
      "to": "bottom"
    },
    {
      "step": "consent",
      "do": "click",
      "text": "不同意"
    }
  ]
}