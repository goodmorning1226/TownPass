{
  "name": "cou_add_then_use",
  "description": "coupon.list goals add_wallet + use_coupon: 加入票夾, 存入票夾, 使用優惠 (opens 票夾 > 優惠券 > 未兌換), tap the 未兌換 coupon, 兌換, 使用, 確定.",
  "page": "coupon_wallet",
  "capability": "coupon.list",
  "goals": [
    "add_wallet",
    "use_coupon"
  ],
  "expect": {
    "done": true
  },
  "actions": [
    {
      "do": "click",
      "selector": "div.py-2.px-4 > div.flex.justify-between > a",
      "step": "coupon_home"
    },
    {
      "step": "coupon_tab",
      "do": "click",
      "text": "優惠券",
      "within": "section.tabs:not(.tabs__content-type)"
    },
    {
      "step": "pick_coupon",
      "do": "click",
      "text": "阿爸手工皂"
    },
    {
      "step": "add_wallet",
      "do": "click",
      "text": "加入票夾"
    },
    {
      "step": "add_wallet",
      "do": "click",
      "text": "存入票夾"
    },
    {
      "step": "use_coupon",
      "do": "click",
      "text": "使用優惠"
    },
    {
      "step": "use_coupon",
      "do": "click",
      "selector": "ul.p-4.flex.flex-col.gap-y-3 > li > a",
      "nth": 1
    },
    {
      "step": "use_coupon",
      "do": "click",
      "text": "兌換"
    },
    {
      "step": "use_coupon",
      "do": "click",
      "text": "使用"
    },
    {
      "step": "done",
      "do": "click",
      "text": "確定"
    }
  ]
}