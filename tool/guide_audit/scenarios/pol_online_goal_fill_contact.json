{
  "name": "pol_online_goal_fill_contact",
  "description": "police.online with goal fill_contact (question plan), opened the app's way. Follows only the cards until the guide is done.",
  "page": "police_report",
  "capability": "police.online",
  "goals": [
    "fill_contact"
  ],
  "expect": {
    "done": true
  },
  "actions": [
    {
