+// TownPass iOS: several whisper-servers run in one App process (no child
+// processes on iOS), so one of them is stopped by its port, not by a signal.
+// townpass_whisper_server_stop(port) stops the listener; main() then frees the
+// model (whisper_free) and returns, as after Ctrl+C. Returns 1 if a server on
+// that port was running. OnDeviceAssistant.swift looks the symbol up with dlsym.
+struct townpass_server_entry {
+    httplib::Server * server;
+    std::atomic<bool> * stopping;
+};
+static std::mutex townpass_servers_mutex;
+static std::map<int, townpass_server_entry> townpass_servers;
+extern "C" __attribute__((visibility("default"))) int townpass_whisper_server_stop(int port) {
+    std::lock_guard<std::mutex> lock(townpass_servers_mutex);
+    auto it = townpass_servers.find(port);
+    if (it == townpass_servers.end()) {
+        return 0;
+    }
+    it->second.stopping->store(true);
+    it->second.server->stop();
+    return 1;
+}
+
 std::atomic_flag is_terminating = ATOMIC_FLAG_INIT;
 
