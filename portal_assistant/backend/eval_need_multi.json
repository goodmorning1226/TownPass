 "meta": {
  "name": "need_multi_turn",
  "sealed": "2026-11-15",
  "usage": "report-only; never used for tuning",
  "outcome_values": {
   "catalog": "assistant shows the category catalog, opens nothing",
   "list": "assistant lists candidates; the list must contain at least one id in ids",
   "open": "assistant opens one of ids",
   "open_position": "assistant opens the item at `position` in the list it showed on the previous turn (any id from that list); must_be_in, when given, restricts which ids are acceptable",
   "faq": "assistant answers from the city FAQ about faq_topic, opens nothing",
   "cancel": "assistant acknowledges cancellation; nothing opened",
   "nothing": "nothing opened"
  },
  "note": "Only user turns are written. Assistant behaviour between turns is implied by the previous turn's expected outcome."
 },
