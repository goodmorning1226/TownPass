+// TownPass iOS: several whisper-servers run in one App process (no child
+// processes on iOS), so one of them is stopped by its port, not by a signal.
+// townpass_whisper_server_stop(port) stops the listener; main() then frees the
+// model (whisper_free) and returns, as after Ctrl+C. Returns 1 if a server on
+// that port was running. OnDeviceAssistant.swift looks the symbol up with dlsym.
+struct townpass_server_entry {
+    httplib::Server * server;
+    std::atomic<bool> * stopping;
+    std::atomic<int> * busy;
+};
+static std::mutex townpass_servers_mutex;
+static std::map<int, townpass_server_entry> townpass_servers;
+extern "C" __attribute__((visibility("default"))) int townpass_whisper_server_stop(int port) {
+    std::lock_guard<std::mutex> lock(townpass_servers_mutex);
+    auto it = townpass_servers.find(port);
+    if (it == townpass_servers.end()) {
+        return 0;
+    }
+    it->second.stopping->store(true);
+    it->second.server->stop();
+    return 1;
+}
+
+// TownPass iOS (2026-11-18): set while the App is not active. iOS refuses GPU work from
+// an App in the background, and one failed Metal command buffer leaves ggml's Metal
+// backend failing every clip until the server is restarted; a clip in progress
+// therefore stops at its next step (abort_callback) and answers 503, and the backend
+// asks again once the App is active. One flag for every server in the App.
+static std::atomic<bool> townpass_paused{false};
+extern "C" __attribute__((visibility("default"))) void townpass_whisper_server_pause(int paused) {
+    townpass_paused.store(paused != 0);
+}
+// Clips the server on that port is handling now (waiting for the model included);
+// -1 when no server runs there. The App restarts only an idle server.
+extern "C" __attribute__((visibility("default"))) int townpass_whisper_server_busy(int port) {
+    std::lock_guard<std::mutex> lock(townpass_servers_mutex);
+    auto it = townpass_servers.find(port);
+    if (it == townpass_servers.end()) {
+        return -1;
+    }
+    return it->second.busy->load();
+}
+// Which fixes this build carries: 1 = the KV cache re-creation no longer frees the
+// state (src/whisper.cpp), so stopping a server (whisper_free) is safe after a failed
+// clip. The App frees a model inside the App only with 1 or more.
+extern "C" __attribute__((visibility("default"))) int townpass_whisper_server_fixes(void) {
+    return 1;
+}
+struct townpass_busy_scope {
+    std::atomic<int> & count;
+    explicit townpass_busy_scope(std::atomic<int> & value) : count(value) { count.fetch_add(1); }
+    ~townpass_busy_scope() { count.fetch_sub(1); }
+};
+
